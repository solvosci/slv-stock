<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sp_assigned_wizard_form" model="ir.ui.view">
        <field name="name">sp.assigned.wizard.form</field>
        <field name="model">sp.assigned.wizard</field>
        <field name="inherit_id" ref="stock_picking_assigned.view_sp_assigned_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="context">{'stock_picking_assigned_batch_link': batch_id}</attribute>
            </xpath>
            
            <xpath expr="//field[@name='lot_id']" position="before">
                <field name="batch_id" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>

            <xpath expr="//page[@name='page_operations']" position="after">
                <page string="Pending Operations">
                    <field name="move_batch_ids">
                        <tree>
                            <field name="picking_id" />
                            <field name="partner_id" />
                            <field name="product_id" />
                            <field name="product_uom_qty" />
                            <field name="quantity_done" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="report_delivery_document_summarized"
        inherit_id="stock.report_delivery_document"
        primary="True"
    >
        <xpath expr="//th[@name='lot_serial']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//tr[@t-as='move_line']" position="before">
            <t t-set="move_lines_main" t-value="[move.move_line_ids[0] for move in o.move_lines.filtered(lambda x: x.quantity_done)]"/>
        </xpath>
        <xpath expr="//tr[@t-as='move_line']" position="attributes">
            <attribute name="t-foreach">move_lines_main</attribute>
        </xpath>
        <xpath expr="//th[@name='lot_serial']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='move_line.lot_id.name']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='move_line.lot_name']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='move_line.qty_done']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>        
        <xpath expr="//span[@t-field='move_line.qty_done']" position="after">
            <span t-field="move_line.move_id.product_uom_qty"/>
        </xpath>
    </template>

    <template id="report_deliveryslip_summarized">
        <t t-foreach="docs" t-as="o">
            <t
                t-call="stock_picking_delivery_slip_summarized.report_delivery_document_summarized"
                t-lang="o.partner_id.lang"
            />
        </t>
    </template>
</odoo>

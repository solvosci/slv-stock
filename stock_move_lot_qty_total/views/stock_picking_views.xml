<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form (in stock_move_line_lot_qty_total)</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock.view_picking_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/tree/field[@name='quantity']"
                position="after"
            >
                <field name="button_complete_lot_qty_invisible" column_invisible="1" />
                <button
                    name="button_complete_lot_qty"
                    type="object"
                    icon="fa-bolt"
                    invisible="button_complete_lot_qty_invisible"
                    help="Automatically fill done quantity for each selected lot with current available stock"
                />
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_ticket" model="report.paperformat">
        <field name="name">Stock Picking Ticket 80mm</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">90</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_stock_picking_pdf" model="ir.actions.report">
        <field name="name">Stock Picking Ticket</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_picking_report_80mm.report_picking</field>
        <field name="report_file">stock_picking_report_80mm.report_picking</field>
        <field name="paperformat_id" ref="stock_picking_ticket"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_delivery_document_detailed_mrp"
            inherit_id="stock.report_delivery_document"
            primary="True">

        <xpath expr="//tr[@t-foreach='o.move_line_ids']/t[@t-call='stock.stock_report_delivery_has_serial_move_line']" position="after">
            <t t-set="move_line_mo" t-value="move_line.production_id.sudo().search([('product_id', '=', move_line.product_id.id), ('lot_producing_id', '=', move_line.lot_id.id), ('state', '=', 'done')], limit=1)" />
            <t t-if="move_line_mo">
                <t t-set="mrp_components" t-value="move_line.sudo().search([('move_id.raw_material_production_id', '=', move_line_mo.id), ('qty_done', '&gt;', 0)])"/>
                <t t-foreach="mrp_components" t-as="mo_move_line">
                    <tr style="border: none; font-style: italic; font-size: 11px; background-color: #f8f9fa;">
                        <td style="padding-left: 25px;">
                            <span t-if="mo_move_line.product_id.default_code" t-field="mo_move_line.product_id.default_code"/>
                        </td>
                        <td>
                            <span t-field="mo_move_line.product_id.name"/>
                        </td>
                        <td t-if="has_serial_number">
                            <span t-if="mo_move_line.lot_id" t-field="mo_move_line.lot_id.name"/>
                        </td>
                        <td class="text-center">
                            <span t-field="mo_move_line.qty_done"/>
                            <span t-field="mo_move_line.product_uom_id"/>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>

    <template id="report_delivery_document_detailed">
        <t t-name="stock_picking_delivery_note_detailed_mrp.report_delivery_document_detailed">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="stock_picking_delivery_note_detailed_mrp.report_delivery_document_detailed_mrp" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_delivery_detailed_mrp" model="ir.actions.report">
        <field name="name">Delivery Slip - detailed</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_picking_delivery_note_detailed_mrp.report_delivery_document_detailed</field>
        <field name="report_file">stock_picking_delivery_note_detailed_mrp.report_delivery_document_detailed</field>
        <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

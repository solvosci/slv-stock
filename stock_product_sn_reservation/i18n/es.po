#: model_terms:ir.ui.view,arch_db:stock_product_sn_reservation.view_stock_move_line_add_sn_wizard_form
msgid ""
"Once done, new lot will be released (if it was\n"
"                            already in use) and then, reserved for this move."
msgstr ""
"Una vez hecho, el nuevo lote será liberado (si ya estaba\n"
"                            en uso) y, a continuación, reservado para este movimiento."

#. module: stock_product_sn_reservation
#: model_terms:ir.ui.view,arch_db:stock_product_sn_reservation.view_stock_move_line_exchange_sn_wizard_form
msgid ""
"Once done, new lot will be released (if it was\n"
"                            already in use) and then, reserved for this move.\n"
"                            Old lot will be released anyway."
msgstr ""
"Una vez realizada la operación, el nuevo lote será liberado (si\n"
"                            estaba realmente en uso) y, a continuación, reservado\n"
"                            para este movimiento. El lote antiguo será liberado."


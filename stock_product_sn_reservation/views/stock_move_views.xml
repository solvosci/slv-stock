<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="name">stock.move.operations.form (in stock_product_sn_reservation)</field>
        <field name="model">stock.move</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_operations"
        />
        <field eval="999" name="priority" />
        <field name="arch" type="xml">
            <field name="move_line_ids" position="before">
                <field name="button_add_sn_invisible" invisible="1" />
                <button
                    name="button_add_sn"
                    type="object"
                    icon="fa-plus-circle"
                    class="oe_highlight"
                    title="Add Serial Number"
                    attrs="{'invisible': [('button_add_sn_invisible', '=', True)]}"
                    groups="stock_product_sn_reservation.group_stock_move_sn_manager"
                >
                    <span>Add Serial Number</span>
                </button>
            </field>
            <field name="move_line_ids" position="before">
                <field name="move_line_ids_readonly" invisible="1" />
            </field>
            <field name="move_line_ids" position="attributes">
                <!-- Original attrs -->
                <!-- attrs="{'readonly': ['|', ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" -->
                <attribute name="attrs">{
                    'readonly': [('move_line_ids_readonly', '=', True)],
                }</attribute>
            </field>
        </field>
    </record>
</odoo>

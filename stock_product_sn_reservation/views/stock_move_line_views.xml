<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree (in stock_product_sn_reservation)</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="button_exchange_lot_sn_invisible" invisible="1" />
                <button
                    name="button_exchange_lot_sn"
                    type="object"
                    icon="fa-exchange"
                    attrs="{
                        'invisible': [('button_exchange_lot_sn_invisible', '=', True)],
                    }"
                    groups="stock_product_sn_reservation.group_stock_move_sn_manager"
                />
                <button
                    name="button_add_unit_lot_sn"
                    type="object"
                    icon="fa-chevron-circle-up"
                    attrs="{
                        'invisible': [
                            '|',
                                ('button_exchange_lot_sn_invisible', '=', True),
                                ('qty_done', '&gt;', 0.0),
                        ],
                    }"
                    groups="stock_product_sn_reservation.group_stock_move_sn_manager"
                />
                <button
                    name="button_remove_lot_sn"
                    type="object"
                    icon="fa-eraser"
                    attrs="{
                        'invisible': [('button_exchange_lot_sn_invisible', '=', True)],
                    }"
                    groups="stock_product_sn_reservation.group_stock_move_sn_manager"
                />
            </field>
        </field>
    </record>
</odoo>

<odoo>

    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.stock.property.form.inherit (in stock_valuation)</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_valuation']/.." position="after">
                <field name="warehouse_valuation" />
            </xpath>
        </field>
    </record>

</odoo>

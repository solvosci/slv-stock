<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.account (in stock_valuation)</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="stock_account.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='module_stock_landed_costs']/../../.." position="after"
            >
                <div
                    class="row mt16 o_settings_container"
                    groups="stock_valuation.group_stock_valuation_close_date_edit"
                >
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        title="Set lock date for warehouse valuations"
                    >
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="warehouse_valuation_close_date"/>
                            <div class="text-muted">
                                Any created or updated warehouse operation that affects products
                                whose valuation is calculated by date and warehouse will raise an error if
                                reference date for this operation is prior to this date. Leave it empty
                                if we cannot forbid any operation depending of its date.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label
                                        for="warehouse_valuation_close_date"
                                        string="Close Date"
                                    />
                                    <field name="warehouse_valuation_close_date"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

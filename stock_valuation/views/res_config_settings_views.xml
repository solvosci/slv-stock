<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.account (in stock_valuation)</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="stock_account.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='group_lot_on_invoice']"
                position="after"
            >
                <setting
                    id="setting_warehouse_valuation_close_date"
                    help="
                        Any created or updated warehouse operation that affects products
                        whose valuation is calculated by date and warehouse will raise an error if
                        reference date for this operation is prior to this date. Leave it empty
                        if we cannot forbid any operation depending of its date.
                    "
                    groups="stock_valuation.group_stock_valuation_close_date_edit"
                >
                    <field name="warehouse_valuation_close_date" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

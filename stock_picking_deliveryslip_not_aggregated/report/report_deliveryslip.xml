<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@name='aggregated_move_lines']/t[@t-call='stock.stock_report_delivery_aggregated_move_lines']" position="attributes">
            <attribute name="t-if">o.picking_type_id.code != 'outgoing'</attribute>
        </xpath>
        <xpath expr="//t[@name='aggregated_move_lines']" position="inside">
            <t t-if="o.picking_type_id.code == 'outgoing'">
                <tr t-foreach="o.move_line_ids" t-as="move_line">
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
        <xpath expr="//t[@t-foreach='packages']//t[@t-call='stock.stock_report_delivery_aggregated_move_lines']" position="attributes">
            <attribute name="t-if">o.picking_type_id.code != 'outgoing'</attribute>
        </xpath>
        <xpath expr="//t[@name='has_packages']//t[@t-else='']" position="inside">
            <t t-if="o.picking_type_id.code == 'outgoing'">
                <tr t-foreach="package_move_lines" t-as="move_line">
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
        <xpath expr="//t[@name='no_package_move_lines']//t[@t-call='stock.stock_report_delivery_aggregated_move_lines']" position="attributes">
            <attribute name="t-if">o.picking_type_id.code != 'outgoing'</attribute>
        </xpath>
        <xpath expr="//t[@name='no_package_move_lines']//t[@t-elif='aggregated_lines']" position="inside">
            <t t-if="o.picking_type_id.code == 'outgoing'">
                <tr t-foreach="move_lines" t-as="move_line">
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
    </template>
    <template id="stock_report_delivery_has_serial_move_line" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//span[@t-field='move_line.product_id']/.." position="after">
            <td>
                <span t-field="move_line.secondary_uom_qty"/>
                <span t-field="move_line.secondary_uom_id.name"/>
            </td>
        </xpath>
    </template>
</odoo>

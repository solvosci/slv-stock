<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purification_privilege" model="res.groups.privilege">
        <field name="name">Purification</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_purification_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="purification_privilege"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_purification_manager" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="purification_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_purification_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>

</odoo>

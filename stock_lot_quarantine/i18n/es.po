msgstr ""
"El lote %(lot)s no está en cuarentena y no puede entrar en una ubicación de "
"cuarentena."

#. module: stock_lot_quarantine
#. odoo-python
#: code:addons/stock_lot_quarantine/models/stock_move.py:0
msgid ""
"Lot %(lot)s is still in quarantine and cannot leave the quarantine area "
"until released."
msgstr ""
"El lote %(lot)s sigue en cuarentena y no puede salir del área de cuarentena "
"hasta que se libere."


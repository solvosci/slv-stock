#. module: stock_lot_quarantine
#. odoo-python
#: code:addons/stock_lot_quarantine/models/stock_location.py:0
msgid ""
"%(location)s is a quarantine location and cannot have its own quarantine "
"twin."
msgstr ""
"%(location)s es una ubicación de cuarentena y no puede tener su propio "
"gemelo de cuarentena."

#. module: stock_lot_quarantine
#. odoo-python
#: code:addons/stock_lot_quarantine/models/stock_location.py:0

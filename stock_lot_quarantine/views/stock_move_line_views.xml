<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_detailed_operation_tree_purification" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.purification</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="product_purifiable" column_invisible="1"/>
                <field name="received_purified" optional="show"
                    invisible="not product_purifiable or picking_code != 'incoming'"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_operations_purification" model="ir.ui.view">
        <field name="name">stock.move.operations.purification</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="product_purifiable" column_invisible="1"/>
                <field name="received_purified" optional="show"
                    invisible="not product_purifiable or picking_code != 'incoming'"/>
            </field>
        </field>
    </record>

</odoo>

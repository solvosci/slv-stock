<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_purification" model="ir.ui.view">
        <field name="name">product.template.form.purification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='qty_available']/.." position="after">
                <group>
                    <field name="purifiable"/>
                    <field name="purification_hours" invisible="not purifiable"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_purification" model="ir.ui.view">
        <field name="name">product.template.search.purification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="combo" position="after">
                <filter name="filter_purifiable" string="Purifiable"
                        domain="[('purifiable', '=', True)]"/>
                <filter name="filter_not_purifiable" string="Not Purifiable"
                        domain="[('purifiable', '=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_logistics_schedule_create_invoice" model="ir.actions.server">
        <field name="name">Create Invoice</field>
        <field name="model_id" ref="model_logistics_schedule" />
        <field name="binding_model_id" ref="model_logistics_schedule" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = model.action_create_invoice_wizard()
        </field>
    </record>

    <record id="action_add_existing_invoice" model="ir.actions.server">
        <field name="name">Add to Existing Invoice</field>
        <field name="model_id" ref="model_logistics_schedule" />
        <field name="binding_model_id" ref="model_logistics_schedule"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">
            action=model.action_add_existing_invoice_wizard()
        </field>
    </record>

    <record id="logistics_schedule_view_form" model="ir.ui.view">
        <field name="name">logistics.schedule.form</field>
        <field name="model">logistics.schedule</field>
        <field name="inherit_id" ref="logistics_planning_base.logistics_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_invoice_wizard"
                    type="object" string="Create Invoice"
                    attrs="{'invisible': ['|', ('is_invoiceable', '=', False), '|', ('account_move_line_id', '!=', False), ('state', '=', 'done')]}"
                    icon="fa-pencil-square-o"
                />
                <button
                    name="action_add_existing_invoice_wizard"
                    type="object" string="Add to Existing Invoice"
                    attrs="{'invisible': ['|', ('is_invoiceable', '=', False), '|', ('account_move_line_id', '!=', False), ('state', '=', 'done')]}"
                    icon="fa-pencil-square-o"
                    groups="account.group_account_user"
                />
            </xpath>
            <xpath expr="//field[@name='transport_type']" position="before">
                <field
                    name="incoterm_id"
                    string="Inco."
                />
            </xpath>
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="is_invoiceable" invisible="1"/>
                <field
                    name="account_move_id"
                    attrs="{'invisible': [('account_move_line_id', '=', False)]}"
                    string="In invoice"
                    groups="account.group_account_invoice"
                />
                <field
                    name="account_move_line_id"
                    attrs="{'invisible': [('account_move_line_id', '=', False)]}"
                    groups="base.group_no_one"
                />
            </xpath>
            <xpath expr="//field[@name='license_plate_2']" position="after">
                <field
                    name="is_finished"
                    attrs="{'invisible': [('is_finished', '=', False)]}"
                    widget="boolean_toggle"
                    groups="account.group_account_invoice"
                />
            </xpath>
        </field>
    </record>

    <record id="logistics_schedule_view_tree" model="ir.ui.view">
        <field name="name">logistics.schedule.tree</field>
        <field name="model">logistics.schedule</field>
        <field name="inherit_id" ref="logistics_planning_base.logistics_schedule_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='transport_type']" position="before">
                <field
                    name="incoterm_id"
                    string="Inco."
                    optional="hide"
                />
            </xpath>
            <xpath expr="//field[@name='note']" position="after">
                <field
                    name="account_move_id"
                    string="Inv."
                    optional="show"
                    groups="account.group_account_invoice"
                />
                <field name="is_invoiceable" invisible="1"/>
                <field
                    name="is_finished"
                    optional="hide"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>

    <record id="logistics_schedule_view_tree_invoicing" model="ir.ui.view">
        <field name="name">logistics.schedule.tree invoicing</field>
        <field name="model">logistics.schedule</field>
        <field
            name="inherit_id"
            ref="logistics_planning_invoicing.logistics_schedule_view_tree"
        />
        <field name="mode">primary</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="." position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="decoration-info">
                    state=='ready' and type=='input'
                </attribute>
                <attribute name="decoration-warning">
                    state=='ready' and type=='output'
                </attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_logistics_schedule_form_view']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- TODO new equivalent "Invoice" button -->
            <xpath
                expr="//button[@name='action_logistics_schedule_form_view']"
                position="after"
            >
                <!-- TODO unify invisible criteria with button form one -->
                <button
                    name="action_create_invoice_wizard"
                    icon="fa-pencil-square-o"
                    class="p-0"
                    type="object"
                    title="Create Invoice"
                    attrs="{'invisible': [('is_invoiceable', '=', False)]}"
                />
                <field name="type" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='schedule_finished']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="logistics_schedule_view_search" model="ir.ui.view">
        <field name="name">logistics.schedule.search (in logistics_planning_invoicing)</field>
        <field name="model">logistics.schedule</field>
        <field
            name="inherit_id"
            ref="logistics_planning_base.logistics_schedule_view_search"
        />
        <field name="arch" type="xml">
            <filter
                name="logistics_price_unit_type_unit"
                position="after"
            >
                <separator groups="account.group_account_invoice"/>
                <filter
                    string="Is invoiceable"
                    name="filter_is_invoiceable"
                    domain="[('is_invoiceable', '=', True)]"
                    groups="account.group_account_invoice"
                />
            </filter>
        </field>
    </record>
</odoo>

<odoo>
    <record id="action_account_move_logistics_schedule" model="ir.actions.act_window">
        <field name="name">Logistic Schedule</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">logistics.schedule</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[("account_move_id", "=", active_id)]</field>
    </record>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_account_move_logistics_schedule)d" class="oe_stat_button" icon="fa-truck" type="action" invisible="logistics_schedule_count == 0" groups="logistics_planning_base.group_lp_user">
                    <div class="o_form_field o_stat_info">
                        <field name="logistics_schedule_ids" invisible="1"/>
                        <field name="logistics_schedule_count" widget="statinfo" string="Logistic Schedule"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='name']" position="after">
                <field name="logistics_schedule_id" optional="hide" groups="logistics_planning_base.group_lp_user"/>
                <field
                    name="agg_logistics_schedule_ids"
                    optional="hide"
                    widget="many2many_tags"
                    groups="logistics_planning_base.group_lp_user"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='analytic_distribution']" position="after">
                <field name="logistics_schedule_id" groups="logistics_planning_base.group_lp_user"/>
                <field
                    name="agg_logistics_schedule_ids"
                    widget="many2many_tags"
                    groups="logistics_planning_base.group_lp_user"
                />
            </xpath>
        </field>
    </record>

</odoo>

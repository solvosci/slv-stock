<odoo>
    <record id="res_config_settings_classification_images_view_form" model="ir.ui.view">
        <field name="name">res.config.settings (classification_images)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='schedule_info']" position="before">
                <block title="Classification Images" id="classification_images_setting_container">
                    <setting id="picking_operations_imagen_max_resolution" string="Max resolution (Px)">
                        <field name="picking_operations_imagen_max_resolution" />
                    </setting>
                    <setting id="picking_operations_imagen_quality" string="Quatily (1 - 100)">
                        <field name="picking_operations_imagen_quality" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

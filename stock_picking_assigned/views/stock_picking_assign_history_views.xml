<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_assign_history_view_form" model="ir.ui.view">
        <field name="name">stock.picking.assign.history.view.form</field>
        <field name="model">stock.picking.assign.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="print_distribution_sheets_ticket" type="object" string="Print Distribution Sheets Ticket" class="btn-primary" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="lot_id" />
                            <!-- <field name="qty_remaining"/> -->
                        </group>
                        <field name="line_ids" mode="tree" readonly="0"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_picking_assign_history_line_tree" model="ir.ui.view">
        <field name="name">stock.picking.assign.history.line.tree</field>
        <field name="model">stock.picking.assign.history.line</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="partner_id" />
                <field name="qty_to_add" />
                <field name="qty_done" />
                <field name="qty_demand" />
            </tree>
        </field>
    </record>

</odoo>

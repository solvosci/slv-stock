<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_assigment_lot" model="ir.cron">
            <field name="name">Set lots as excluded for assignment</field>
            <field name="model_id" ref="model_stock_production_lot" />
            <field name="state">code</field>
            <field name="code">model.cron_exclude_old_records()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False" />
            <field name="doall" eval="False" />
        </record>
    </data>
</odoo>

<odoo>

    <record id="report_stock_lot_date_view_search" model="ir.ui.view">
        <field name="name">report.stock.lot.date.search</field>
        <field name="model">report.stock.lot.date</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id" />
                <field name="product_id" />
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_by_product_id" domain="[]" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="report_stock_lot_date_view_tree" model="ir.ui.view">
        <field name="name">report.stock.lot.date.view.tree</field>
        <field name="model">report.stock.lot.date</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="product_id" widget="many2onebutton" />
                <field name="lot_id" widget="many2onebutton" />
                <field name="qty" />
                <field name="uom_id" optional="show"/>
                <field name="company_id" optional="show" />
            </tree>
        </field>
    </record>

    <record id="report_stock_lot_date_view_tree_without_product" model="ir.ui.view">
        <field name="name">report.stock.lot.date.view.tree</field>
        <field name="model">report.stock.lot.date</field>
        <field name="inherit_id" ref="stock_lot_available_at_date.report_stock_lot_date_view_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>

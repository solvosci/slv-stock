#. module: stock_restrict_lot_update_priorize
#: model:ir.model.fields,help:stock_restrict_lot_update_priorize.field_stock_move__restict_lot_priorized
msgid ""
"\n"
"        When restict lot is filled and this check selected,\n"
"        the lot will be reserved even if there are existing reservations,\n"
"        stealing them, if needed and possible\n"
"        "
msgstr ""
"\n"
"        Cuando el lote restringido está cubierto y este check seleccionado,\n"
"        se reservará dicho lote incluso si ya hay reservas previas en otros documentos,\n"
"        robándoselo a estos, si resulta necesario y posible\n"
"        "

#. module: stock_restrict_lot_update_priorize
#: model:ir.model.fields,field_description:stock_restrict_lot_update_priorize.field_stock_move__restict_lot_priorized
msgid "Force lot reservation"
msgstr "Forzar reserva del lote"

#. module: stock_restrict_lot_update_priorize
#: model_terms:ir.ui.view,arch_db:stock_restrict_lot_update_priorize.view_picking_form
#: model_terms:ir.ui.view,arch_db:stock_restrict_lot_update_priorize.view_stock_move_operations
msgid "If checked, system will try to steal this lot even if it's already reserved"
msgstr "Si está marcado, el sistema tratará de robar este lote incluso si está ya reservado en otra parte"


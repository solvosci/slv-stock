<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_capture_zone_form_biological" model="ir.ui.view">
        <field name="name">intecmar.capture.zone.form.biological</field>
        <field name="model">intecmar.capture.zone</field>
        <field name="inherit_id" ref="stock_intecmar_capture_zone.view_capture_zone_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Sanitary Classifications" name="biological_zone_page">
                    <field name="biological_zone_line_ids">
                        <list>
                            <field name="biological_zone_id"/>
                            <field name="product_type_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>

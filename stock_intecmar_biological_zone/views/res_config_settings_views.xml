<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_biological_zone" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.biological.zone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Biological Classification" name="biological_zone_setting_container">
                    <setting id="biological_zone_api_url_setting"
                        help="Endpoint the biological classification sync downloads">
                        <field name="biological_zone_api_url" placeholder="https://www.intecmar.gal/Api/EstadoZonasProducion/ClasificacionMicrobioloxicaZonas"/>
                        <field name="biological_zone_last_update_date" readonly="1" groups="base.group_no_one"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>

<odoo>
    <record id="consignment_note_paperform" model="report.paperformat">
        <field name="name">Consignment Note Report</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">65</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_consignment_note_report_pdf" model="ir.actions.report">
        <field name="name">Consignment Note Report PDF</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="stock_picking_batch_delivery_carrier_adr.consignment_note_paperform"/>
        <field name="report_name">stock_picking_batch_delivery_carrier_adr.stock_picking_batch_template</field>
        <field name="print_report_name">
            'Consignment Note %s' % (object.create_date.strftime('%d-%m-%Y'))
        </field>
        <field name="report_file">stock_picking_batch_delivery_carrier_adr.stock_picking_batch_template</field>
        <field name="binding_model_id" ref="model_stock_picking_batch"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

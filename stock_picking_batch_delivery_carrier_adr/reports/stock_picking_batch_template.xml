<odoo>
    <template id="stock_picking_batch_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="pickings" t-value="o.picking_ids"/>
                <div class="page" style="page-break-after: always;">
                    <div class="header text-center">
                        <h2 class="text-center;">
                            <strong>
                                A.D.R. CONSIGNEMENT NOTE
                            </strong>
                        </h2>
                        <div class="d-flex">
                            <div class="w-50" style="font-size: 16px;">
                                <strong>Date:</strong> <span t-field="o.scheduled_date"/>
                            </div>
                            <div class="w-50" style="font-size: 16px;">
                                <strong>Reference Nº:</strong> <span t-field="o.name"/>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex">
                        <t t-call="stock_picking_batch_delivery_carrier_adr.address_block">
                            <t t-set="title">Sender</t>
                            <t t-set="partner" t-value="o.company_id"/>
                        </t>
                        <t t-call="stock_picking_batch_delivery_carrier_adr.address_block">
                            <t t-set="title">Transporter</t>
                            <t t-set="partner" t-value="o.carrier_id.partner_id"/>
                            <t t-set="carrier_name" t-value="o.carrier_id.name"/>
                        </t>
                    </div>
                    <div>
                        <table style="margin-top: 20px; width: 100%; font-size: 16px;">
                            <thead style="color: indigo; border: 2px solid black;">
                                <tr>
                                    <th style="border-right: 2px solid black;" class="p-2">Delivery note</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Consignee</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Town City</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Pack Nº</th>
                                    <th style="border-right: 2px solid black;" class="p-2">KG</th>
                                    <th class="p-2">ADR Pack Nº.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="pickings" t-as="picking">
                                    <tr style="text-align: center; border: 1px solid black;">
                                        <td style="border-right: 1px solid black;"><span t-field="picking.name"/></td>
                                        <t t-if="picking.partner_id">
                                            <td style="border-right: 1px solid black;"><span t-field="picking.partner_id"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="picking.partner_id.city"/></td>
                                        </t>
                                        <t t-else="">
                                            <td style="border-right: 1px solid black;"><span t-field="picking.location_dest_id.warehouse_id.partner_id"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="picking.location_dest_id.warehouse_id.partner_id.city"/></td>
                                        </t>
                                        <td style="border-right: 1px solid black;"><span t-field="picking.package_qty"/></td>
                                        <td style="border-right: 1px solid black;"><span t-field="picking.packages_weight"/></td>
                                        <td><span t-field="picking.adr_package_qty"/></td>
                                    </tr>
                                </t>
                                <tr style="text-align: center;">
                                    <td></td>
                                    <td></td>
                                    <td style="border: 1px solid black;">TOTAL</td>
                                    <td style="border: 1px solid black;"><span t-field="o.package_qty"/></td>
                                    <td style="border: 1px solid black;"><span t-field="o.packages_weight"/></td>
                                    <td style="border: 1px solid black;"><span t-field="o.adr_package_qty"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <table style="margin-top: 20px; width: 100%; font-size: 16px;">
                            <thead style="color: indigo; border: 2px solid black;">
                                <tr>
                                    <th style="border-right: 2px solid black;" class="p-2">UN Nº</th>
                                    <th style="border-right: 2px solid black;" class="p-2">UN Description</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Class</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Group</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Cod.</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Pack Desc.</th>
                                    <th style="border-right: 2px solid black;" class="p-2">Pack Nº</th>
                                    <th class="p-2">KG</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_packages_qty" t-value="0"/>
                                <t t-set="total_packages_weight" t-value="0"/>
                                <t t-foreach="o.move_ids" t-as="move">
                                    <t t-if="move.is_dangerous">
                                        <tr style="text-align: center; border: 1px solid black;">
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_goods_id.un_number"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_goods_id.clean_name"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_class_id.code"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_goods_id.transport_category"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_tunnel_restriction_code"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.product_id.adr_goods_id.package_description"/></td>
                                            <td style="border-right: 1px solid black;"><span t-field="move.package_qty"/></td>
                                            <td><span t-field="move.packages_weight"/></td>
                                        </tr>
                                        <t t-set="total_packages_qty" t-value="total_packages_qty + move.package_qty"/>
                                        <t t-set="total_packages_weight" t-value="total_packages_weight + move.packages_weight"/>
                                    </t>
                                </t>
                                <tr style="text-align: center">
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td style="border: 1px solid black;">TOTAL</td>
                                    <td style="border: 1px solid black;"><span t-esc="total_packages_qty"/></td>
                                    <td style="border: 1px solid black;"><span t-esc="total_packages_weight" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div style="margin-top: 20px; font-size: 14px; border: 1px solid black; padding: 5px; text-align: center;">
                            <strong>
                                TRANSPORT WHICH DOES NOT EXCEED THE LIMITS ESTABLISHED IN 1.1.3.6.<br/>
                                WE DECLARE THAT THE GOODS ARE ADMITTED FOR ROAD TRANSPORT ACCORDING TO ADR REGULATIONS AND THAT THEIR CONDITION, PACKAGING, LABELING COMPLY WITH ADR PRESCRIPTIONS.
                            </strong>
                        </div>
                        <div style="border: 1px solid black; border-top: none;">
                            <div style="border-top: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; padding-bottom: 50px;">
                                OBSERVATIONS / REMARKS:
                            </div>
                        </div>
                        <div class="d-flex" style="margin-top: 20px; font-size: 14px;">
                            <div class="w-50" style="text-align: center;">
                                <u>THE LOADER</u>
                            </div>
                            <div class="w-50" style="text-align: center;">
                                <u>THE CONSIGNOR</u>
                            </div>
                        </div>
                    </div >
                </div>
            </t>
        </t>
    </template>
    <template id="address_block">
        <div class="w-50">
            <div style="font-size: 12px;">
                <strong><t t-esc="title"/>:</strong>
            </div>
            <div style="font-size: 12px;">
                <strong>Name:</strong>
                <t t-if="title == 'Transporter'">
                    <span t-esc="carrier_name"/> (<span t-field="partner.vat"/>)
                </t>
                <t t-else="">
                    <span t-field="partner.name"/> (<span t-field="partner.vat"/>)
                </t>
            </div>
            <div style="font-size: 12px;">
                <strong>Address:</strong> <span t-field="partner.street"/>
            </div>
            <div style="font-size: 12px;">
                <strong>Town City:</strong> <span t-field="partner.city"/>
            </div>
            <div style="font-size: 12px;">
                <strong>Province:</strong> <span t-field="partner.state_id"/>
            </div>
            <div style="font-size: 12px;">
                <strong>Country:</strong> <span t-field="partner.country_id"/>
            </div>
        </div>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_toxin_zone" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.toxin.zone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Shellfish Toxin Zone Control" name="toxin_zone_setting_container">
                    <setting id="toxin_zone_intecmar_url_setting"
                        help="Endpoint the INTECMAR sync downloads">
                        <field name="toxin_zone_intecmar_url" placeholder="https://www.intecmar.gal/Api/EstadoZonasProducion/EstadoZonasBiotoxinas"/>
                        <field name="toxin_zone_last_update_date" readonly="1" groups="base.group_no_one"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_capture_product_type_list" model="ir.ui.view">
        <field name="name">intecmar.capture.product.type.list</field>
        <field name="model">intecmar.capture.product.type</field>
        <field name="arch" type="xml">
            <list string="Capture Product Types">
                <field name="code" readonly="id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_capture_product_type_form" model="ir.ui.view">
        <field name="name">intecmar.capture.product.type.form</field>
        <field name="model">intecmar.capture.product.type</field>
        <field name="arch" type="xml">
            <form string="Capture Product Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_zones"
                            class="oe_stat_button" icon="fa-map-marker">
                            <field name="zone_count" widget="statinfo" string="Capture Zones"/>
                        </button>
                    </div>
                    <group>
                        <field name="code" readonly="id"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_capture_product_type" model="ir.actions.act_window">
        <field name="name">Capture Product Types</field>
        <field name="res_model">intecmar.capture.product.type</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>

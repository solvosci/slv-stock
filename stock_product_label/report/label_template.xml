    <template id="dynamic_label_renderer">
        <t t-set="template_xmlid"
            t-value="product.get_label_template_xml_id()"/>

        <t t-call="{{ template_xmlid }}"/>
    </template>

    <template id="product_template_label_wo_lot">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="product" t-value="o"/>
                <t t-set="barcode" t-value="o.barcode"/>
                <t t-set="lot" t-value="False"/>

                <t t-call="stock_product_label.dynamic_label_renderer"/>
            </t>
        </t>
    </template>

    <template id="product_product_label_wo_lot">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="product" t-value="o"/>
                <t t-set="barcode" t-value="o.barcode"/>
                <t t-set="lot" t-value="False"/>

                <t t-call="stock_product_label.dynamic_label_renderer"/>
            </t>
        </t>
    </template>

    <template id="product_label_with_lot">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="product" t-value="o.product_id"/>
                <t t-set="barcode" t-value="o.product_id.barcode"/>
                <t t-set="lot" t-value="o.lot_id"/>

                <t t-call="stock_product_label.dynamic_label_renderer"/>
            </t>
        </t>
    </template>

    <template id="stock_picking_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="picking">

                <t t-foreach="picking.move_ids_without_package.filtered(lambda x: x.state == 'done')" t-as="move">
                    <t t-set="product" t-value="move.product_id"/>
                    <t t-set="barcode" t-value="move.product_id.barcode"/>

                    <!-- si un producto lo piden con varios lotes sale un ticket por cada lote -->
                    <t t-if="move.move_line_ids.filtered(lambda l: l.lot_id)">
                        <t t-foreach="move.move_line_ids.filtered(lambda l: l.lot_id)" t-as="line">
                            <t t-set="o" t-value="line"/>
                            <t t-set="lot" t-value="line.lot_id"/>
                            <t t-call="stock_product_label.dynamic_label_renderer"/>
                        </t>
                    </t>

                    <t t-else="">
                        <t t-set="o" t-value="move"/>
                        <t t-set="lot" t-value="False"/>
                        <t t-call="stock_product_label.dynamic_label_renderer"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="stock_quant_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="product" t-value="o.product_id"/>
                <t t-set="barcode" t-value="o.product_id.barcode"/>
                <t t-set="lot" t-value="o.lot_id"/>

                <t t-call="stock_product_label.dynamic_label_renderer"/>
            </t>
        </t>
    </template>

</odoo>

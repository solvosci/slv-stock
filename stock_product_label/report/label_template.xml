<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- test cliente -->
    <template id="label_generic_layout">
        <div class="page" style="page-break-after: always;">
            <div style="display:inline-block; width:53%; font-size:13px; margin-top:5px; word-wrap:break-word;vertical-align:top;">
                <div name="barcode" t-if="barcode">
                    <!-- <span>Ref:</span> -->
                    <strong><span t-out="barcode"/></strong>
                </div>
                <div name="lot" t-if="lot">
                    <span>Lot/SN:</span>
                    <strong><span t-out="lot.name"/></strong>
                </div>
            </div>
            <div style="display:inline-block; width:42%; margin-top:10px;vertical-align:top; margin-left: 5px;" name="qr">
                <img t-att-src="'data:image/png;base64,%s' % o.mh10_data_encoded.decode()" style="width:80px; height:80px;"/>
            </div>
        </div>
    </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_lot_form" model="ir.ui.view">
        <field name="name">product.label.lot.form</field>
        <field name="model">product.label.lot.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id" />
                        <field name="lot_id"  domain="[('product_id', '=', product_id)]"/>
                    </group>
                </group>
                <footer>
                    <button name="print_label_by_lot" string="Print" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">stock.move.form.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                    name="logistics_schedule_id"
                    readonly="1"
                    invisible="not logistics_schedule_id"
                    groups="logistics_planning_base.group_lp_user"
                />
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                    name="logistics_schedule_disabled"
                    readonly="state != 'done' or logistics_schedule_id"
                    widget="boolean_toggle"
                    groups="logistics_planning_base.group_lp_manager"
                />
                <field
                    name="warehouse_partner_id"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>

</odoo>

<odoo>
    <record id="res_config_settings_scale_view_form" model="ir.ui.view">
        <field name="name">res.config.settings (scale)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Scale" id="scale_setting_container">
                    <setting
                        id="show_picking_operations_weight_max"
                        string="Max. weight for scale operations"
                    >
                        <field name="picking_operations_weight_max" />
                    </setting>
                    <setting
                        id="show_picking_operations_camera_id"
                        string="Camera"
                    >
                        <field name="picking_operations_camera_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_production_lot_date_wizard_view_form" model="ir.ui.view">
        <field name="name">report.stock.production.lot.date.wizard.form</field>
        <field name="model">report.stock.production.lot.date.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <group>
                    <group>
                        <field name="date" required="1" />
                    </group>
                    <group>
                        <field name="product_id" />
                    </group>
                </group>
                <footer>
                    <button
                        name="open_lot_at_date_report"
                        string="View lots"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
